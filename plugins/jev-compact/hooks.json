{
  "hooks": {
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/hooks/run.sh\" pre-compact",
            "timeout": 600,
            "statusMessage": "fast-jev: scoring tool calls"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/hooks/run.sh\" session-start",
            "timeout": 60,
            "statusMessage": "fast-jev: checking backfill"
          }
        ]
      }
    ]
  }
}
